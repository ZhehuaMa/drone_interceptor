# 修改后执行：sudo systemctl restart drone-interceptor
# CPU 绑定列表（taskset 语法）。板上 4-7 为 isolcpus 隔离的 Cortex-A72 大核。
CPU_LIST=4-7
ROS_DOMAIN_ID=0
# 仿真模式；真实飞行保持 false。
USE_SIMULATION=false
# 雷达中继中制导（对应 launch 的 use_radar）。
USE_RADAR=false
# 末端视觉丢失后重新接管（对应 launch 的 radar_reintercept_enable）。
RADAR_REINTERCEPT=false
LOG_LEVEL=INFO
# 使用其他参数文件时设置 DI_CONFIG=/绝对路径/params.yaml
